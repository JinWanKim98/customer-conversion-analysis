  "plan": {
    "chapter": "09",
    "written_before_chapter09_outcome_computation": true,
    "design_basis": "Original Kevin Hillstrom 2008 randomized email test; three approximately equal arms, two-week follow-up",
    "contract": "docs/04_metric_contract.json v1.0.0; unchanged",
    "unit": "one assigned customer row; all 64000 rows retained, identical attributes are not proof of duplicate identities",
    "control": "No E-Mail",
    "treatments": [
      "Mens E-Mail",
      "Womens E-Mail"
    ],
    "assignment_interpretation": "Product content of email, not customer sex/gender; assigned-arm analysis, no conditioning on visit, conversion, opens or receipt",
    "primary": "two-week conversion probability difference versus control, percentage points, intention to treat",
    "primary_test": "two-sided pooled two-proportion z test without continuity correction; Holm adjustment over the two treatment-versus-control purchase comparisons, family alpha 0.05",
    "primary_intervals": "95% marginal Newcombe-Wilson difference intervals without continuity correction; not simultaneous or Holm-adjusted confidence intervals",
    "secondary": [
      "two-week visit-rate difference",
      "mean recorded spend difference per assigned customer, including zero spend"
    ],
    "secondary_status": "exploratory estimates and marginal intervals, not additional confirmatory endpoints",
    "spend": "original nominal dollars; parse exact integer cents, never round silently or remove nonpurchasers/outliers",
    "spend_bootstrap": {
      "method": "ordinary within-arm customer-row bootstrap; compress identical spend values with multinomial frequencies; all assigned rows including zeros",
      "replicates": 10000,
      "seed": 1729,
      "arm_draw_order": [
        "No E-Mail",
        "Mens E-Mail",
        "Womens E-Mail"
      ],
      "interval": "linear 2.5/97.5 percentile",
      "shared_control": "use the same control draws for both treatment contrasts"
    },
    "allocation_diagnostic": "chi-square goodness-of-fit to the source's nominal equal thirds, 2 df; flag at p<0.001; passing does not prove randomization",
    "baseline_balance": {
      "numeric": [
        "recency",
        "history"
      ],
      "binary": [
        "mens",
        "womens",
        "newbie"
      ],
      "categorical": [
        "history_segment",
        "zip_code",
        "channel"
      ],
      "method": "treatment-control standardized mean difference with pooled unweighted sample variances; categorical indicators per observed level",
      "display_flag": "absolute SMD > 0.1; descriptive, not proof of randomization and not a rule for post-hoc deletion/reweighting"
    },
    "head_to_head": "Mens minus Womens estimate and 95% marginal interval only; exploratory and outside the two-test primary family; do not infer a universal winner from treatment-versus-control tests",
    "validation": "independent Python integer aggregation versus in-memory SQL; custom Newcombe/z/Holm versus installed statsmodels and scipy; raw/hash preservation",
    "boundaries": "no join to REES46, no subgroup targeting model, no ROI/profit or current-market claim; absent delivery/compliance/customer-ID/cost/margin information limits verification and decisions"
  },
